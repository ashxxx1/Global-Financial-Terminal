# Firebase API Keys — copy to .env.local and fill in values
# NEVER commit .env.local to git
# Runs locally only for now — put values in .env.local (see bottom of this file).

# ── Firebase ──
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# ── Admin ──
VITE_ADMIN_EMAIL=aarushkapoor23@gmail.com

# ── Runs locally: copy this file to .env.local and run `npm run dev` (http://localhost:5173). No cloud hosting configured. ──

# ── Market Data APIs (optional — app works with mock data without these) ──
VITE_GNEWS_API_KEY=your_gnews_key
VITE_ALPHA_VANTAGE_KEY=your_alpha_vantage_key

# Set to "false" to let visitors browse without an account (default: auth required)
VITE_REQUIRE_AUTH=true

# Product analytics (PostHog) — optional; app runs fine without it
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Live US stock quotes + OHLCV candles (Finnhub free tier).
# LOCAL DEV: set VITE_FINNHUB_API_KEY for a direct fallback (vite dev has no /api).
# PRODUCTION (Vercel): set FINNHUB_API_KEY (NO vite prefix) — server-side secret,
# used by /api/quote and /api/candles so the key never ships in the browser bundle.
# NOTE: Finnhub free tier returns 403 on /stock/candle. /api/candles falls back to
# Yahoo Finance delayed history automatically. Optional: ALPHA_VANTAGE_KEY.
VITE_FINNHUB_API_KEY=
ALPHA_VANTAGE_KEY=

# ── GFT Signals ──
# Default: demo track record (deterministic, clearly labeled DEMO).
# Set VITE_SIGNALS_DEMO_MODE=false and VITE_SIGNALS_LIVE=true once live generation
# + resolution have produced a real public track record.
VITE_SIGNALS_DEMO_MODE=true
VITE_SIGNALS_LIVE=false
# Optional backend base URL (also used for SSE market feeds)
# VITE_API_URL=https://your-backend.onrender.com
# Cron auth for /api/signals/jobs/* and Vercel cron proxies
CRON_SECRET=
SIGNALS_DEMO_MODE=true
