# API Keys — copy this file to .env and fill in your keys
# NEVER commit .env to git

# GNews API (free: 100 req/day) — https://gnews.io/
VITE_GNEWS_API_KEY=your_gnews_api_key_here

# Alpha Vantage (free: 25 req/day) — https://www.alphavantage.co/
VITE_ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# News API (optional, free: 100 req/day) — https://newsapi.org/
VITE_NEWS_API_KEY=your_news_api_key_here
