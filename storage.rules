rules_version = '2';

// Forum media (post images/video). Uploads live at forum_media/{uid}/{file}
// — the uid segment is the path-level ownership check, mirroring the
// authorId checks in firestore.rules. Everything else is closed.
service firebase.storage {
  match /b/{bucket}/o {
    match /forum_media/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|video/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
