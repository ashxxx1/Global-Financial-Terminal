rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A signed-in user owns exactly one document: their own profile.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // User voice. Create-only from the client: anyone signed in can leave
    // feedback, but nobody can read the pile back — responses are read from
    // the console or an admin SDK, never the browser.
    match /feedback/{doc} {
      allow create: if request.auth != null
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() < 4001;
      allow read, update, delete: if false;
    }
    match /pmf_responses/{doc} {
      allow create: if request.auth != null
                    && request.resource.data.answer in ["very", "somewhat", "not"];
      allow read, update, delete: if false;
    }

    // GFT Signals — public read-only track record. Clients never write.
    // Generation/resolution is server-side only (Admin SDK / backend).
    match /signals/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /signal_results/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /model_versions/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /daily_performance/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Sequential member numbers. Any signed-in client may draw a number, but
    // the only legal write is a +1 increment — so a hostile client cannot
    // reset the counter, skip ahead, or hand itself #1.
    match /meta/memberCounter {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.next is int
                    && request.resource.data.next <= 4;
      allow update: if request.auth != null
                    && request.resource.data.next == resource.data.next + 1;
      allow delete: if false;
    }

    // ── Forum ──────────────────────────────────────────────────────
    // A lightweight community board: posts (text + up to 4 media), one
    // repost record per (post, user), and comments as a subcollection.
    // Every op requires a session — the app is already sign-in gated by
    // default (see lib/auth.ts authRequired), so this matches the rest
    // of the schema rather than opening a new public surface.
    function signedIn() { return request.auth != null; }

    match /forum_posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.media is list
                    && request.resource.data.media.size() <= 4
                    && request.resource.data.commentCount == 0
                    && request.resource.data.repostCount == 0;
      // No edit feature — the only legal update is bumping one of the two
      // denormalized counters by exactly +/-1, so a commenter/reposter can
      // touch someone else's post doc without forging a count or rewriting
      // its content.
      allow update: if signedIn() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
          && (request.resource.data.commentCount == resource.data.commentCount + 1
              || request.resource.data.commentCount == resource.data.commentCount - 1)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['repostCount'])
          && (request.resource.data.repostCount == resource.data.repostCount + 1
              || request.resource.data.repostCount == resource.data.repostCount - 1))
      );
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 1000;
        allow update: if false;
        allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      }
    }

    // One doc per (post, user) repost, id "{postId}_{uid}" so a toggle is
    // just create-or-delete on a deterministic path — no query needed to
    // check "have I already reposted this".
    match /forum_reposts/{repostId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && repostId == request.resource.data.postId + '_' + request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
