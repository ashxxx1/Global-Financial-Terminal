rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is admin
    function isAdmin() {
      return request.auth != null && (request.auth.token.email == "aarushkapoor23@gmail.com" || request.auth.token.email == "anchitaduggal7@gmail.com" || request.auth.token.email == "anchitaduggal@7gmail.com");
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.uid == uid && request.resource.data.email == request.auth.token.email;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }

    match /counters/{counterId} {
      allow read, write: if request.auth != null;
    }

    // Secure Social Posts
    match /social_posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      // Allow updates if author OR if only updating metrics (likeCount, replyCount, repostCount, viewCount, poll, isDeleted)
      allow update: if request.auth != null && (
         resource.data.authorId == request.auth.uid ||
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'replyCount', 'repostCount', 'viewCount', 'poll', 'isDeleted'])
      );
      allow delete: if request.auth != null && (resource.data.authorId == request.auth.uid || isAdmin());
    }
    
    match /post_comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null && (
         resource.data.authorId == request.auth.uid ||
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
      );
      allow delete: if request.auth != null && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // Secure Messages
    match /messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null && (
          resource.data.authorId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'isDeleted'])
      );
      allow delete: if request.auth != null && (resource.data.authorId == request.auth.uid || isAdmin());
    }
    
    match /channel_messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null && (
          resource.data.authorId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'isDeleted'])
      );
      allow delete: if request.auth != null && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // Server architecture rules
    match /social_servers/{serverId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }
    match /social_channels/{channelId} {
      allow read, write: if request.auth != null;
    }
    match /social_categories/{categoryId} {
      allow read, write: if request.auth != null;
    }
    match /social_topics/{topicId} {
      allow read, write: if request.auth != null;
    }

    // Follows & Blocks
    match /follows/{followId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.resource.data.followerId == request.auth.uid;
    }
    match /blocks/{blockId} {
      allow read, write: if request.auth != null;
    }
    match /notifications/{notifId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null; 
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    match /hashtags/{tagId} {
      allow read, write: if request.auth != null;
    }
  }
}
