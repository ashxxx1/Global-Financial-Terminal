rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A signed-in user owns exactly one document: their own profile.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // User voice. Create-only from the client: anyone signed in can leave
    // feedback, but nobody can read the pile back — responses are read from
    // the console or an admin SDK, never the browser.
    match /feedback/{doc} {
      allow create: if request.auth != null
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() < 4001;
      allow read, update, delete: if false;
    }
    match /pmf_responses/{doc} {
      allow create: if request.auth != null
                    && request.resource.data.answer in ["very", "somewhat", "not"];
      allow read, update, delete: if false;
    }

    // GFT Signals — public read-only track record. Clients never write.
    // Generation/resolution is server-side only (Admin SDK / backend).
    match /signals/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /signal_results/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /model_versions/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /daily_performance/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
