rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      // Users can read their own doc
      allow read: if request.auth != null && request.auth.uid == uid;

      // New users can create their own doc (only with pending/approved status)
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email;

      // Users can only update their own lastLogin field
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin']);

      // Admin can read and write any user doc
      allow read, write: if request.auth != null
        && request.auth.token.email == "aarushkapoor23@gmail.com";
    }
  }
}
