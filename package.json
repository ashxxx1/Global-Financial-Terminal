{
  "name": "global-financial-terminal",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-sitemap.mjs && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run build",
    "setup": "npm ci && git config core.hooksPath .githooks && echo \"\u2714 hooks installed \u2014 pre-push now runs npm run verify\"",
    "research:selftest": "node scripts/research-selftest.mjs",
    "research:test": "node scripts/research-tests.mjs",
    "impact:test": "npx --yes tsx scripts/impact-tests.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.18.0",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "firebase": "^12.15.0",
    "framer-motion": "^12.42.0",
    "globe.gl": "^2.46.1",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.460.0",
    "posthog-js": "^1.407.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-globe.gl": "^2.38.0",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.0.0",
    "three": "^0.184.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^15.24.0",
    "globals": "^17.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.12"
  },
  "engines": {
    "node": ">=18"
  }
}
