# Firebase & Vercel API Keys — copy to .env.local and fill in values
# NEVER commit .env.local to git

# ── Firebase ──
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# ── Admin ──
VITE_ADMIN_EMAIL=aarushkapoor23@gmail.com

# ── Vercel Deploy Hook (get from Vercel Dashboard → Settings → Git → Deploy Hooks) ──
VITE_VERCEL_DEPLOY_HOOK=https://api.vercel.com/v1/integrations/deploy/YOUR_HOOK_URL

# ── Market Data APIs (optional — app works with mock data without these) ──
VITE_GNEWS_API_KEY=your_gnews_key
VITE_ALPHA_VANTAGE_KEY=your_alpha_vantage_key
